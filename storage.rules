rules_version = '2';

// Clock-in/out photos.
//  - Uploads go through the server (Admin SDK) OR the authenticated worker into
//    their own folder only. Reads limited to the owner and admins.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /shift-photos/{uid}/{fileName} {
      // Worker can upload only into their own uid folder; images only; <= 8MB.
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
