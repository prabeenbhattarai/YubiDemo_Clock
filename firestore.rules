rules_version = '2';

// -----------------------------------------------------------------------------
//  Security model
//  - ALL writes go through server API routes using the Admin SDK (which bypasses
//    these rules). Clients therefore have NO write access here — this prevents a
//    worker from forging a shift, faking approval status, or editing hours.
//  - Reads are allowed only for the owning worker (matched by auth uid) or an
//    admin (custom claim `admin == true`). This powers the real-time listeners.
// -----------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.admin == true; }
    function ownsUid(uid) { return signedIn() && request.auth.uid == uid; }

    // Sites: any signed-in user may read (workers need site details & geofence).
    match /sites/{siteId} {
      allow read: if signedIn();
      allow write: if false; // server only
    }

    // Workers: a worker may read only their own record; admins read all.
    match /workers/{workerId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false; // server only
    }

    // Shifts (clock-in/out): owner or admin may read; writes server-only.
    match /shifts/{shiftId} {
      allow read: if isAdmin() || (resource != null && ownsUid(resource.data.workerUid));
      allow write: if false; // server only
    }

    // Manual timesheets: owner or admin may read; writes server-only.
    match /timesheets/{tsId} {
      allow read: if isAdmin() || (resource != null && ownsUid(resource.data.workerUid));
      allow write: if false; // server only
    }

    // OTP codes: never readable/writable by clients.
    match /otps/{email} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
